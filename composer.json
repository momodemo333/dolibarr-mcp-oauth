{
    "name": "momodemo333/dolibarr-mcp-oauth",
    "description": "Shared OAuth 2.1 + HTTP exposure layer for MCP-enabled Dolibarr modules (emMCP, Dalfred)",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "DolibarrMcpOAuth\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "DolibarrMcpOAuth\\Tests\\": "tests/" },
        "files": [ "tests/Fakes/DolibarrShim.php" ]
    },
    "config": {
        "platform": { "php": "8.1.32" }
    }
}
